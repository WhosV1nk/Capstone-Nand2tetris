// Memory.hdl
// Memory map: RAM16K (0..16383), Screen (16384..24575), Keyboard (24576).
// Depends on the standard RAM16K, Screen and Keyboard chips.

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Split writes between the lower RAM and upper memory-mapped region.
    DMux(in=load, sel=address[14], a=loadRAM, b=loadUpper);
    DMux(in=loadUpper, sel=address[13], a=loadScreen, b=loadUnused);

    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);

    // Select RAM when address[14]=0. Otherwise select Screen or Keyboard.
    Mux16(a=screenOut, b=keyboardOut, sel=address[13], out=upperOut);
    Mux16(a=ramOut, b=upperOut, sel=address[14], out=out);
}
